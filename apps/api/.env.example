NODE_ENV=development
PORT=3000

# PostgreSQL 16 with pgvector extension
DATABASE_URL=postgresql://interest_user:interest_pass@localhost:5432/interest_db

# Redis 7 (BullMQ & Cache)
REDIS_URL=redis://localhost:6379

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=interest-reels
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
CDN_BASE_URL=http://localhost:9000/interest-reels

# JWT Auth
JWT_SECRET=development-secret-jwt-key-replace-in-production-min32chars
JWT_REFRESH_SECRET=development-secret-jwt-refresh-key-replace-in-production-min32chars
