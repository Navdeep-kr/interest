# =============================================================================
# Root Monorepo Environment Configuration Template
# Project: "Interest" - Pure Interest-Driven Short-Video App
# =============================================================================

NODE_ENV=development

# Database (PostgreSQL 16 with pgvector)
DATABASE_URL=postgresql://interest_user:interest_pass@localhost:5432/interest_db

# Redis 7 (Queues, Bloom Filters, Telemetry)
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO local or AWS S3 / Cloudflare R2)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=interest-reels
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
CDN_BASE_URL=http://localhost:9000/interest-reels

# Authentication Secrets
JWT_SECRET=development-secret-jwt-key-replace-in-production-min32chars
JWT_REFRESH_SECRET=development-secret-jwt-refresh-key-replace-in-production-min32chars

# Ports
API_PORT=3000
ADMIN_PORT=3001
