{
  "name": "interest-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Interest - The Pure Interest-Driven Short-Video Social App",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm --prefix apps/api run start:dev",
    "dev:mobile": "npm --prefix apps/mobile start",
    "dev:admin": "npm --prefix apps/admin run dev",
    "build": "turbo run build",
    "build:shared": "npm --prefix packages/shared run build",
    "build:api": "npm --prefix apps/api run build",
    "test": "npm --prefix apps/api test",
    "test:security": "npm --prefix apps/api test -- test/security/owasp-top10.spec.ts",
    "test:load:feed": "k6 run tests/load/k6/feed-infinite-scroll.k6.js",
    "test:load:upload": "k6 run tests/load/k6/creator-upload-pipeline.k6.js",
    "test:e2e:maestro": "npm --prefix apps/mobile run e2e:maestro",
    "test:e2e:detox:ios": "npm --prefix apps/mobile run e2e:detox:ios",
    "test:e2e:detox:android": "npm --prefix apps/mobile run e2e:detox:android",
    "test:ci": "node scripts/verify-zero-location.js && npm --prefix apps/api test",
    "check:zero-location": "node scripts/verify-zero-location.js",
    "eval:feed": "node scripts/offline-feed-evaluation.js",
    "lint": "eslint \"**/*.{ts,tsx,js}\"",


    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "prepare": "node -e \"try { require('husky')() } catch (e) {}\""
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "prettier": "^3.2.5",
    "turbo": "^1.13.3",
    "typescript": "^5.4.5"
  }
}
